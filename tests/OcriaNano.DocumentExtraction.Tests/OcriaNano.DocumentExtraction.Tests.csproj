<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);MEDE0001;EXTEXP0019;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Lift the abstractions to the #7963 build (GetText/EnumerateContent), as the samples do. -->
    <PackageReference Include="Microsoft.Extensions.Documents.Abstractions" Version="11.0.0-preview.1.26600.4" />
    <!-- Shapes Arabic when rendering non-Latin test pages; matches the SkiaSharp that PDFtoImage brings. -->
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OcriaNano.DocumentExtraction\OcriaNano.DocumentExtraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Golden\data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
