<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Prototype packages built from unmerged dotnet/extensions PRs. See eng/packages/README.md. -->
    <add key="local" value="eng/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Microsoft.Extensions.Documents.Abstractions" />
    </packageSource>
    <packageSource key="nuget.org">
      <!-- Published versions (src/OcriaNano.DocumentExtraction builds against 26560.3) still come from nuget.org. -->
      <package pattern="Microsoft.Extensions.Documents.Abstractions" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
